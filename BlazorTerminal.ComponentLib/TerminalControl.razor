@using BlazorTerminal.ComponentLib.Models
@using BlazorTerminal.ComponentLib.TerminalGui

<div class="blazor-terminal">
    @for (int r = 0; r < Buffer.Rows; r++)
    {
        <div class="terminal-row">
            @for (int c = 0; c < Buffer.Columns; c++)
            {
                var cell = Buffer[r, c];
                var style = GetStyle(cell);
                var cursorClass = Cursor.Visible && Cursor.Row == r && Cursor.Column == c
                    ? $"cursor {Cursor.Shape.ToString().ToLower()}"
                    : string.Empty;
                <span class="terminal-cell @cursorClass" style="@style">@cell.Character</span>
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// Number of rows displayed by the terminal.
    /// </summary>
    [Parameter]
    public int Rows { get; set; } = 24;

    /// <summary>
    /// Number of columns displayed by the terminal.
    /// </summary>
    [Parameter]
    public int Columns { get; set; } = 80;

    private ScreenBuffer Buffer = default!;
    private CursorState Cursor = new();

    protected override void OnInitialized()
    {
        Buffer = new ScreenBuffer(Rows, Columns);
    }

    private bool _demoStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_demoStarted)
        {
            _demoStarted = true;
            await SimulateTypingAsync("Welcome to BlazorTerminal!\n");
        }
    }

    /// <summary>
    /// Simulate typing text into the terminal with a small delay between characters.
    /// </summary>
    private async Task SimulateTypingAsync(string text, int delayMs = 50)
    {
        foreach (var ch in text)
        {
            Write(ch.ToString());
            await Task.Delay(delayMs);
        }
    }

    /// <summary>
    /// Write text to the terminal at the current cursor position.
    /// Lines that exceed the terminal width will wrap automatically.
    /// </summary>
    /// <param name="data">Text to write.</param>
    public void Write(string data)
    {
        foreach (var ch in data)
        {
            if (ch == '\r')
            {
                Cursor.Column = 0;
                continue;
            }
            if (ch == '\n')
            {
                MoveToNewLine();
                continue;
            }

            if (Cursor.Column >= Columns)
            {
                MoveToNewLine();
            }

            Buffer[Cursor.Row, Cursor.Column] = new TerminalCell(ch);
            Cursor.Column++;

            if (Cursor.Column >= Columns)
            {
                MoveToNewLine();
            }
        }

        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Write text followed by a newline to the terminal.
    /// </summary>
    /// <param name="data">Text to write.</param>
    public void WriteLine(string data)
    {
        Write(data);
        MoveToNewLine();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Sets the cursor position to the specified row and column.
    /// </summary>
    public void SetCursorPosition(int row, int column)
    {
        Cursor.Row = Math.Clamp(row, 0, Rows - 1);
        Cursor.Column = Math.Clamp(column, 0, Columns - 1);
    }

    /// <summary>
    /// Clears the entire terminal screen.
    /// </summary>
    public void Clear()
    {
        Buffer = new ScreenBuffer(Rows, Columns);
        Cursor.Row = 0;
        Cursor.Column = 0;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Writes text at a specific position in the terminal.
    /// </summary>
    public void DrawAt(int row, int column, string text)
    {
        var savedRow = Cursor.Row;
        var savedColumn = Cursor.Column;

        SetCursorPosition(row, column);
        Write(text);

        Cursor.Row = savedRow;
        Cursor.Column = savedColumn;
    }

    /// <summary>
    /// Draws a box at the specified position with the given dimensions and border style.
    /// </summary>
    public void DrawBox(int row, int column, int width, int height, BorderStyle? borderStyle = null, string? title = null)
    {
        var boxLines = Box.Draw(width, height, borderStyle, title);
        for (int i = 0; i < boxLines.Length; i++)
        {
            DrawAt(row + i, column, boxLines[i]);
        }
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Draws a panel at its designated position.
    /// </summary>
    public void DrawPanel(Panel panel)
    {
        var lines = panel.Render();
        for (int i = 0; i < lines.Length; i++)
        {
            DrawAt(panel.Row + i, panel.Column, lines[i]);
        }
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Draws a progress bar at the specified position.
    /// </summary>
    public void DrawProgressBar(int row, int column, ProgressBar progressBar)
    {
        DrawAt(row, column, progressBar.Render());
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Draws a menu at the specified position.
    /// </summary>
    public void DrawMenu(int row, int column, Menu menu)
    {
        var lines = menu.Render();
        for (int i = 0; i < lines.Length; i++)
        {
            DrawAt(row + i, column, lines[i]);
        }
        InvokeAsync(StateHasChanged);
    }

    private void MoveToNewLine()
    {
        Cursor.Column = 0;
        Cursor.Row++;
        if (Cursor.Row >= Rows)
        {
            ScrollUp();
            Cursor.Row = Rows - 1;
        }
    }

    private void ScrollUp()
    {
        for (int r = 1; r < Rows; r++)
        {
            for (int c = 0; c < Columns; c++)
            {
                Buffer[r - 1, c] = Buffer[r, c];
            }
        }
        for (int c = 0; c < Columns; c++)
        {
            Buffer[Rows - 1, c] = new TerminalCell(' ');
        }
    }

    private static string GetStyle(TerminalCell cell)
    {
        var style = $"color:{cell.Style.ForegroundColor};background-color:{cell.Style.BackgroundColor};";
        if (cell.Style.Attributes.HasFlag(TextAttribute.Bold)) style += "font-weight:bold;";
        if (cell.Style.Attributes.HasFlag(TextAttribute.Italic)) style += "font-style:italic;";
        if (cell.Style.Attributes.HasFlag(TextAttribute.Underline)) style += "text-decoration:underline;";
        if (cell.Style.Attributes.HasFlag(TextAttribute.Inverse))
        {
            style += $"color:{cell.Style.BackgroundColor};background-color:{cell.Style.ForegroundColor};";
        }
        return style;
    }
}
